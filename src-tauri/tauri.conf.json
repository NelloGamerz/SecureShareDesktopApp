{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "server-frontend",
  "version": "0.1.0",
  "identifier": "com.karan.server-frontend",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "server-frontend",
        "width": 800,
        "height": 600,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },

  "plugins": {
    "updater": {
      "active": true,

      "endpoints": ["https://your-domain.com/latest.json"],

      "dialog": false,

      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyQjI5N0JEOTUzRjYwQ0YKUldUUFlEK1Z2WmV5NGwwMWg5QWZTOVhEZTFsZU91dWJVcG1jNzlySHo5MmZwN3dKaDY1QVhNT3gK"
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",

    "resources": [],

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

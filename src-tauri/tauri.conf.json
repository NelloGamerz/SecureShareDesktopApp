{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VilSend",
  "version": "0.2.6",
  "identifier": "in.vilsend.app",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "VilSend",
        "width": 800,
        "height": 600,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },

  "plugins": {
    "updater": {
      "active": true,

      "endpoints": ["https://update.vilsend.in/latest.json"],

      "dialog": false,

      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyQjI5N0JEOTUzRjYwQ0YKUldUUFlEK1Z2WmV5NGwwMWg5QWZTOVhEZTFsZU91dWJVcG1jNzlySHo5MmZwN3dKaDY1QVhNT3gK"
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,

    "resources": [],

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

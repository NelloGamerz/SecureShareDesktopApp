<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedCapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <!--
    `Version` is a placeholder. The store build overwrites it from the release
    tag (see "UPDATE PACKAGE VERSION" in .github/workflows/release.yml), so the
    value here only matters when packaging an MSIX by hand. Keep it in step
    with the `version` field in Cargo.toml, which is the single source of truth.
  -->
  <Identity
    Name="VilSend"
    Publisher="CN=VilSend"
    Version="1.0.4.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>VilSend</DisplayName>
    <PublisherDisplayName>VilSend</PublisherDisplayName>
    <Description>VilSend</Description>

    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Applications>

    <Application
      Id="VilSend"
      Executable="vilsend.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        AppListEntry="none"
        DisplayName="VilSend"
        Description="VilSend"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <!--
        Registers the `vilsend://` scheme so the OAuth callback can return to
        the app. MSIX packages ignore the registry-based registration that the
        NSIS/WiX installers perform, so the scheme must be declared here as
        well. Keep in sync with `plugins.deep-link.desktop.schemes` in
        tauri.conf.json.
      -->
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="vilsend" />
        </uap:Extension>
      </Extensions>

    </Application>

  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
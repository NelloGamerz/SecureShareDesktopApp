# Clerk Authentication
# Get these from https://dashboard.clerk.com
#
# Publishable key for your Clerk instance. The frontend API origin
# (https://clerk.<your-domain>) is derived from it automatically.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Desktop OAuth (system browser, Authorization Code + PKCE)
# ---------------------------------------------------------------------------
#
# Client ID of a Clerk **OAuth application** (Dashboard -> Developers ->
# OAuth applications) configured as a PUBLIC client. The desktop app is a
# public client and must never hold a Clerk secret key.
VITE_CLERK_OAUTH_CLIENT_ID=

# Redirect URI. Must match the scheme registered in crates/desktop/tauri.conf.json
# under plugins.deep-link.desktop.schemes, and be allow-listed on the Clerk
# OAuth application.
VITE_CLERK_OAUTH_REDIRECT_URI=vilsend://auth/callback

# Space-separated scopes sent to the authorization endpoint.
VITE_CLERK_OAUTH_SCOPES=openid profile email

# Optional. Normally derived from VITE_CLERK_PUBLISHABLE_KEY; set only to
# override, e.g. when using a custom Clerk domain.
# VITE_CLERK_OAUTH_ISSUER=https://clerk.your-domain.com

# Optional OIDC `prompt` sent only for the sign-up action. Leave unset unless
# your Clerk instance supports steering the authorize page to registration.
# VITE_CLERK_OAUTH_SIGNUP_PROMPT=

# API base URL (your backend / Tauri IPC bridge)
VITE_API_BASE_URL=http://localhost:8000

# App metadata
VITE_APP_NAME=VilSend

# ---------------------------------------------------------------------------
# Release signing (never commit a value here)
# ---------------------------------------------------------------------------
#
# Bundling a signed updater artifact needs `TAURI_SIGNING_PRIVATE_KEY` and
# `TAURI_SIGNING_PRIVATE_KEY_PASSWORD`. Both are read from the environment:
# CI supplies them from repository secrets, and a local `tauri build` needs
# them exported in the shell.
#
# Do NOT add them to `.env` or to any tracked file. Losing this key breaks
# auto-update for every installed client, so keep it in a password manager as
# well as in the CI secret.

